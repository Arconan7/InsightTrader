modules = ["nodejs-24"]
run = "node server.mjs"
entrypoint = "server.mjs"

[env]
PORT = "3000"

[deployment]
run = ["node", "server.mjs"]
deploymentTarget = "autoscale"

[workflows]
runButton = "Start Node Server"

[[workflows.workflow]]
name = "Start Node Server"
author = "agent"

[workflows.workflow.metadata]
agentRequireRestartOnSave = false

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "node server.mjs"
